{
  "name": "live-quiz-starter",
  "main": "src/index.ts",

  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],

  "dev": {
    "port": 8787
  },

  // public/ доторх файлыг (тест client) шууд static байдлаар serve хийнэ.
  // Файлтай таарахгүй замууд (/rooms/...) Worker-ийн fetch() руу очно.
  "assets": {
    "directory": "./public"
  },

  // TODO 1: Durable Object-ийг Worker-т "холбох" (binding) + migration нэмнэ.
  //   - durable_objects.bindings: name = "QUIZ_ROOM" (кодонд env.QUIZ_ROOM), class_name = "QuizRoom"
  //   - migrations: tag = "v1", new_sqlite_classes = ["QuizRoom"]
  //   Заавар: https://developers.cloudflare.com/durable-objects/get-started/
  // "durable_objects": { ... },
  // "migrations": [ ... ],

  "observability": {
    "enabled": true
  }
}
