{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["es2022"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src", "scripts"]
}
